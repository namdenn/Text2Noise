# Optional Conda shell initialization. Leave empty if `conda` is already
# available as a shell function.
export CONDA_INIT=/path/to/conda.sh
export CONDA_ENV_PATH=diffuse
export CONDA_ENV=diffuse

# Repository and Text-to-Noise data/checkpoints.
export PROJ_ROOT=/path/to/repository
export DATA_ROOT=/path/to/data
export TEXT_ENCODER_CHECKPOINT=/path/to/text_encoder.pt
export METADATA_INPUT_DIR=/path/to/metadata/input
export METADATA_OUTPUT_DIR=/path/to/metadata/output

# Speech-enhancement inputs.
export SPEECH_CKPT=/path/to/speech_prior.ckpt
export NOISE_CKPT=/path/to/noise_model.ckpt
export NOISE_METADATA=/path/to/metadata/test.jsonl
export NOISY_ROOT=/path/to/noisy_audio
export CLEAN_ROOT=/path/to/clean_audio

# Optional experiment tracking. Obtain this value from your own W&B account.
export WANDB_PROJECT=audio-modeling
export WANDB_API_KEY=replace_with_your_own_key
