# Optional Conda shell initialization. Leave empty if `conda` is already
# available as a shell function.
export CONDA_INIT=/path/to/miniconda3/etc/profile.d/conda.sh
export CONDA_ENV_PATH=diffuse
export CONDA_ENV=diffuse

# Repository and Text-to-Noise data/checkpoints.
export PROJ_ROOT=/path/to/Text2Noise
export CORPUS_ROOT=/path/to/text2noise_corpus
export TEXT_ENCODER_CHECKPOINT=/path/to/text_encoder_only.pt
export CONETTE_METADATA_DIR=/path/to/conette_metadata
export CONETTE_ENCODED_DIR=/path/to/conette_metadata_encoded

# Speech-enhancement inputs.
export SPEECH_CKPT=/path/to/speech_prior.ckpt
export NOISY_ROOT=/path/to/noisy_eval_corpus
export CLEAN_ROOT=/path/to/clean_eval_corpus

# Optional experiment tracking. Obtain this value from your own W&B account.
export WANDB_API_KEY=replace_with_your_own_key
